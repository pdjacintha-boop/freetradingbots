<!-- Time filter -->
<block type="time_between" id="time_1">
  <field name="start">${server_start}</field>
  <field name="end">${server_end}</field>
</block>

<!-- Indicators -->
<block type="ema" id="ema_short">
  <field name="period">9</field>
  <field name="source">close</field>
</block>
<block type="ema" id="ema_long">
  <field name="period">21</field>
  <field name="source">close</field>
</block>
<block type="rsi" id="rsi_1">
  <field name="period">14</field>
  <field name="source">close</field>
</block>
<block type="momentum" id="mom_1">
  <field name="period">10</field>
  <field name="source">close</field>
</block>

<!-- Signal: EMA crossover -->
<block type="ema_crossover_signal" id="signal_ema">
  <field name="short">ema_short</field>
  <field name="long">ema_long</field>
</block>

<!-- Filters: RSI and Momentum thresholds (aggressive: loose) -->
<block type="rsi_filter" id="filter_rsi">
  <field name="rsi">rsi_1</field>
  <field name="lower">30</field>
  <field name="upper">70</field>
</block>
<block type="momentum_filter" id="filter_mom">
  <field name="momentum">mom_1</field>
  <field name="threshold">0</field>
</block>

<!-- Payout check -->
<block type="payout_check" id="payout_1">
  <field name="min_multiplier">${min_payout_multiplier}</field>
</block>

<!-- Trade counters / risk -->
<block type="trade_counter" id="counter_1">
  <field name="max_trades">${max_trades_day}</field>
</block>
<block type="consec_loss_stop" id="loss_1">
  <field name="max_losses">${max_consec_losses}</field>
</block>

<!-- Martingale manager -->
<block type="martingale" id="mg_1">
  <field name="enabled">${martingale_enabled}</field>
  <field name="levels">3</field>
  <field name="multiplier_1">${mg_level_1}</field>
  <field name="multiplier_2">${mg_level_2}</field>
  <field name="multiplier_3">${mg_level_3}</field>
</block>

<!-- Rise/Fall trade block (60 seconds) -->
<block type="trade_rise_fall" id="trade_rf">
  <field name="contract_type">rise_fall</field>
  <field name="duration_type">seconds</field>
  <field name="duration_value">60</field>
  <field name="stake">${stake}</field>
  <field name="side">auto</field>
  <field name="require_min_payout">true</field>
</block>

<!-- Digital trade block (1 tick) -->
<block type="trade_digital" id="trade_dg">
  <field name="contract_type">DIGITAL</field>
  <field name="duration_type">ticks</field>
  <field name="duration_value">1</field>
  <field name="stake">${stake}</field>
  <field name="side">auto</field>
  <field name="require_min_payout">true</field>
</block>
